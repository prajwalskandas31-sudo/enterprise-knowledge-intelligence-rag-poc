# =============================================================================
# ENTERPRISE KNOWLEDGE INTELLIGENCE RAG & SNOWFLAKE CORTEX ANALYST POC
# Copy this file to .env and replace the values with your credentials.
# =============================================================================

# Application Core Configuration
APP_NAME="Enterprise Knowledge Intelligence RAG POC"
APP_ENV="development"
DEBUG=true
PORT=8000

# -----------------------------------------------------------------------------
# FREE TIER & LOCAL ZERO-COST PROVIDER CONFIGURATIONS
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER:
#   - "sentence-transformers" : 100% Free & Open-Source (runs locally via CPU/GPU)
#   - "mock"                 : 100% Free & Offline (deterministic unit vector hashing)
#   - "openai"               : Optional cloud provider (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# LLM_PROVIDER:
#   - "mock"   : 100% Free & Offline (contextual rule/synthesis engine)
#   - "ollama" : 100% Free & Open-Source (connects to local Ollama server)
#   - "openai" : Optional cloud provider (requires OPENAI_API_KEY)
LLM_PROVIDER="mock"
LLM_MODEL_NAME="mock-llm-v1"

# -----------------------------------------------------------------------------
# OPTIONAL EXTERNAL PROVIDER API KEYS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Chunker & Retrieval Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
SIMILARITY_THRESHOLD=0.0

# Vector & Document Storage Paths
VECTOR_STORE_PATH="data/vector_store.json"
DATA_DIR="data/samples"

# -----------------------------------------------------------------------------
# SNOWFLAKE CORTEX ANALYST & SQL API CONFIGURATION
# Replace SNOWFLAKE_PAT with your Snowflake Programmatic Access Token.
# -----------------------------------------------------------------------------
SNOWFLAKE_BASE_URL="https://YOUR_ACCOUNT_IDENTIFIER.snowflakecomputing.com"
SNOWFLAKE_ACCOUNT="YOUR_ACCOUNT_IDENTIFIER"
SNOWFLAKE_USER="YOUR_SNOWFLAKE_USERNAME"
SNOWFLAKE_PAT="your_snowflake_programmatic_access_token_here"
SNOWFLAKE_ROLE="ACCOUNTADMIN"
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"
SNOWFLAKE_DATABASE="FDP_CORTEX_POC"
SNOWFLAKE_SCHEMA="RAW_DATA"
SNOWFLAKE_SEMANTIC_VIEW="FDP_CORTEX_POC.RAW_DATA.CUSTOMER_ANALYTICS"