# Application Configuration
APP_NAME="Enterprise Knowledge Intelligence RAG POC"
APP_ENV="development"
DEBUG=true
PORT=8000

# -----------------------------------------------------------------------------
# FREE TIER & LOCAL ZERO-COST PROVIDER CONFIGURATIONS (DEFAULT)
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER:
#   - "sentence-transformers" : 100% Free & Open-Source (runs locally via CPU/GPU, no API key needed)
#   - "mock"                 : 100% Free & Offline (deterministic unit vector hashing for testing)
#   - "openai"               : Optional paid cloud provider (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# LLM_PROVIDER:
#   - "mock"   : 100% Free & Offline (contextual rule/synthesis engine, zero external requests)
#   - "ollama" : 100% Free & Open-Source (connects to local Ollama server running Llama 3/Mistral)
#   - "openai" : Optional paid cloud provider (requires OPENAI_API_KEY)
LLM_PROVIDER="mock"
LLM_MODEL_NAME="mock-llm-v1"

# -----------------------------------------------------------------------------
# OPTIONAL PAID/EXTERNAL API KEYS (Leave empty for 100% Free Local Execution)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Chunker Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval Configuration
TOP_K=3
SIMILARITY_THRESHOLD=0.0

# Storage Configuration (Local Free Storage)
VECTOR_STORE_PATH="data/vector_store.json"
DATA_DIR="data/samples"
